# Server & Public Routing (Cloudflare Tunnel -> K3s ClusterIP)
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8090
PUBLIC_DOMAIN=voice-mcp.cooperlabs.app
MCP_API_KEY=change-me-generate-with-openssl-rand-hex-32

# Telephony Provider: "telnyx" (recommended, ~50% cheaper) or "twilio"
TELEPHONY_PROVIDER=telnyx
OUTBOUND_CALLER_NUMBER=+15550001234

# Telnyx Credentials ($1.00/mo number, ~$0.007/min outbound + streaming)
TELNYX_API_KEY=KEY019...
TELNYX_CONNECTION_ID=253...

# Twilio Credentials (Optional fallback if TELEPHONY_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Local Audio Pipeline Models (Cached on Longhorn PVC at /data/models)
WHISPER_MODEL_SIZE=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
TTS_ENGINE=piper
PIPER_VOICE_MODEL=en_US-lessac-medium
KOKORO_VOICE=af_heart

# Turn-Taking & Timeout Guards
VAD_SPEECH_THRESHOLD=0.5
VAD_SILENCE_DURATION_MS=700
VAD_MIN_SPEECH_DURATION_MS=220
FILLER_DELAY_SECONDS=1.25
DEFAULT_ANSWER_TIMEOUT_SECONDS=45.0
DEFAULT_LISTEN_TIMEOUT_SECONDS=25.0
DATA_DIR=/data
